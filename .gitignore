node_modules/

# Vite build output.
app/web/dist/

# Theme gallery specimens. These ARE committed: the theme picker is unusable
# without them (it falls back to a token swatch that cannot show type or a
# plate background), and regenerating 38 themes needs LibreOffice and a few
# minutes, which is the wrong thing to do on a container's first boot. They
# render with branding off, so they carry no institutional marks — only the
# committed themes. Regenerate with `npm run gallery`.
!app/gallery/
# The themesheet contact sheets are a development aid, not a product asset.
app/gallery/themesheet*.png

# Private decks — per-user work, never committed. Public examples are the exception.
decks/*
!decks/_public
!decks/_public/**
!decks/README.md

# Generated artefacts — reproducible from sources, never committed.
decks/*/out/
decks/*/assets/
decks/_public/*/out/
decks/.specimen-cache/
.plate-cache/

# Per-deck chat state — conversation transcript and extracted standing
# decisions, both derived from deck.yaml and the thread, never hand-edited.
decks/*/chat.jsonl
decks/*/decisions.md
brand/generated/
brand/fonts/
*.pptx
*.docx
!reference/*.docx
*.pdf
!reference/*.pdf
# Published presentations — your actual decks, intentionally committed for showcase
!published/
!published/**

# LibreOffice scratch profiles created during rasterisation.
**/.lo-profile/

.env
.DS_Store

# Institutional marks are trademarks — `npm run brand` generates neutral
# placeholders when this directory is empty.
brand/logos/
!brand/logos/README.md

# Real identity details. config/identity.example.yaml is the committed template.
config/identity.yaml

# Local-only API keys written by the Settings/Cloud panel. Never committed;
# models.yaml only references them as env:NAME.
config/local.yaml
config/hosted.json

# Local single-install accounts and their sessions — the Cloud-key gate. Never
# committed: users.json holds scrypt hashes, sessions.json holds bearer tokens.
# SQLite DB (forge.db) holds the same data encrypted plus vault and auto usage.
config/users.json
config/sessions.json
config/forge.db
config/forge.db-*
config/*.db
config/*.db-*

# Saved briefing formats — per-user, per the account store.
config/presets/

# Staged briefing documents — upload-only research mode. Short-lived (swept
# after the TTL), never part of the repo.
config/uploads/

# Per-account state. Identity overrides and brand marks are stored under a hash
# of the account's address, and the root-level entries above do not reach them:
# `brand/logos/` does not match `brand/users/<id>/logos/`. Same stale-allow-list
# shape that put config/forge.db into the Docker image — see .dockerignore.
config/identities/
brand/users/

# Source institutional templates: these carry third-party names and roll
# numbers, and are reference material rather than source.
reference/
!reference/.gitkeep
test/fixtures/

# Theme audit contact sheets — a look-at-it scratch dir, regenerated on demand.
.themeaudit/
