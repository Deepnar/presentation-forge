node_modules/

# Vite build output.
app/web/dist/

# Generated artefacts — reproducible from sources, never committed.
decks/*/out/

# Per-deck chat state — conversation transcript and extracted standing
# decisions, both derived from deck.yaml and the thread, never hand-edited.
decks/*/chat.jsonl
decks/*/decisions.md
brand/generated/
brand/fonts/
*.pptx
*.docx
!reference/*.docx
*.pdf
!reference/*.pdf

# LibreOffice scratch profiles created during rasterisation.
**/.lo-profile/

.env
.DS_Store

# Institutional marks are trademarks — `npm run brand` generates neutral
# placeholders when this directory is empty.
brand/logos/
!brand/logos/README.md

# Real identity details. config/identity.example.yaml is the committed template.
config/identity.yaml

# Source institutional templates: these carry third-party names and roll
# numbers, and are reference material rather than source.
reference/
