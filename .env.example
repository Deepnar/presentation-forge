# Copy to docker/.env and fill in. See docs/DEPLOY.md for the full walkthrough.
#
# A local clone needs none of this — the app runs local-first with no env at
# all. These are the hosted-deployment settings.

# ---------------------------------------------------------------- required

# The public hostname. Used by the TLS profile to get a Let's Encrypt cert.
FORGE_DOMAIN=forge.example.com

# Encrypts every per-user API key at rest. Hosted mode REFUSES TO START without
# it rather than fall back to the development constant, which is published in
# this repository and would make the encryption decorative.
#   openssl rand -base64 48
FORGE_KEY_PEPPER=

# SearXNG's own signing secret.
#   openssl rand -hex 32
SEARXNG_SECRET=

# ------------------------------------------------------------------ mode

# Hosted (1): Auto is the shared gateway, Cloud is per-user BYOK, no Ollama.
# Local (0 / unset): Auto falls back to Ollama at localhost:11434.
FORGE_HOSTED=1

# The shared gateway key — the free tier every signed-in user can generate on
# without bringing a key. Rate-limited per account by the FORGE_AUTO_* caps.
FORGE_TCET_API_KEY=

# Optional BYOK providers. Users attach their own keys in Settings → Cloud,
# which are encrypted per account; these are only the install-wide fallback.
OPENAI_API_KEY=
OPENCODE_GO_API_KEY=

# ------------------------------------------------------------------ admin

# The operator's account. Seeded at boot from this pair; if the address already
# has an account (registered normally, or via Google) it is promoted instead.
# This is the ONLY way an admin comes into existence besides promotion by an
# existing admin — the address alone never grants admin, because registration
# does not verify email ownership.
FORGE_ADMIN_EMAIL=owner@example.com
FORGE_ADMIN_PASSWORD=

# Set to 0 to close self-registration on a public box.
FORGE_OPEN_REGISTRATION=1

# ------------------------------------------------------------- networking

# Published port. Bound to 127.0.0.1 by default because Caddy is the public
# listener; set FORGE_BIND=0.0.0.0 to serve the app directly without TLS.
FORGE_PORT=8080
FORGE_BIND=127.0.0.1

# Comma-separated allowed browser origins. Empty = same-origin only, which is
# the normal case when the API serves the built UI itself.
FORGE_UI_ORIGIN=

# Login/register attempts per 10 minutes per IP.
FORGE_AUTH_RATE_LIMIT=20

# A token unused for this long is revoked; using it refreshes the clock.
FORGE_SESSION_TTL_DAYS=30

# Container memory ceiling. LibreOffice and Chromium are the spikes — a limit
# means a burst of renders fails a render instead of OOM-killing the box.
FORGE_MEM_LIMIT=6g

# ------------------------------------------------------------- retention

# Decks older than this many days of inactivity are deleted. This is what stops
# a free-tier disk filling up: a deck with previews is 5-15 MB. Empty disables.
FORGE_SWEEP_DAYS=30
FORGE_SWEEP_HOUR=3

# Sweep notification email — plain SMTP via src/mail.js. Optional.
FORGE_SMTP_HOST=
FORGE_SMTP_PORT=587
FORGE_SMTP_USER=
FORGE_SMTP_PASS=
FORGE_SMTP_FROM=forge-sweep@example.com
FORGE_SMTP_TO=owner@example.com
FORGE_SMTP_SECURE=0

# ---------------------------------------------------------- auto-tier caps

# What one account may spend on the shared gateway. Tighten on a busy box.
FORGE_AUTO_HOURLY_REQUESTS=20
FORGE_AUTO_WEEKLY_REQUESTS=100
FORGE_AUTO_HOURLY_SLIDES=60
FORGE_AUTO_WEEKLY_SLIDES=300
FORGE_AUTO_WEEKLY_TOKENS=200000
FORGE_AUTO_MAX_SLIDES_PER_DECK=30

# ------------------------------------------------------------------ oauth

# Google sign-in. Optional; email/password works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
