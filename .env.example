# Copy to docker/.env and fill in. All values are optional — the app runs
# local-first with none of them set; these turn on the monthly sweep, sweep
# email and the production CORS allow-list.

# Public port for the app (docker-compose.app.yml maps it to :5174 inside).
FORGE_PORT=8080

# Monthly sweep: delete decks older than this many days of inactivity.
# Leave empty to disable the sweep entirely.
FORGE_SWEEP_DAYS=30
# Run the sweep daily at this hour (0-23).
FORGE_SWEEP_HOUR=3

# Sweep email — plain SMTP via src/mail.js.
FORGE_SMTP_HOST=smtp.example.com
FORGE_SMTP_PORT=587
FORGE_SMTP_USER=
FORGE_SMTP_PASS=
FORGE_SMTP_FROM=forge-sweep@example.com
FORGE_SMTP_TO=owner@example.com
# Set to 1 for implicit TLS (port 465 style).
FORGE_SMTP_SECURE=0

# Login/register attempts allowed per 10 minutes per IP.
FORGE_AUTH_RATE_LIMIT=20

# Set to 0 on a public box to close self-registration. The operator's account
# is then seeded on boot from the two FORGE_ADMIN_* values below.
FORGE_OPEN_REGISTRATION=1
FORGE_ADMIN_EMAIL=owner@example.com
FORGE_ADMIN_PASSWORD=

# Session idle timeout in days. A token unused for this long is revoked; using
# the token refreshes its clock.
FORGE_SESSION_TTL_DAYS=30

# Set to 1 when a reverse proxy (nginx/caddy) fronts the box, so the rate
# limiter counts each visitor's real IP instead of the proxy's.
FORGE_TRUST_PROXY=0

# Comma-separated allowed browser origins. Empty = same-origin only (the
# normal case when the built UI is served by the API itself).
FORGE_UI_ORIGIN=

# Hosted vs local — single repo, one switch. GitHub clone = local by default.
# FORGE_HOSTED=1 → your hosted site: Auto = TCET only, Cloud = BYOK, NO Ollama fallback.
# FORGE_HOSTED=0 / unset → local download: Auto falls back to Ollama at localhost:11434 when TCET is absent.
FORGE_HOSTED=1

# TCET CoE Gateway — the shared "auto" model every student can use without a key.
# Fork local/cloud → auto/cloud: auto = this campus gateway (free), cloud = your own key.
FORGE_TCET_API_KEY=sk-a2b090cb0285727213f476a5215d2cc4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FORGE_KEY_PEPPER=change-me-to-a-long-random-32b-string-for-key-encryption

# Auto-tier usage limits (hourly / weekly). Tighten on a busy box.
FORGE_AUTO_HOURLY_REQUESTS=20
FORGE_AUTO_WEEKLY_REQUESTS=100
FORGE_AUTO_HOURLY_SLIDES=60
FORGE_AUTO_WEEKLY_SLIDES=300
FORGE_AUTO_WEEKLY_TOKENS=200000
FORGE_AUTO_MAX_SLIDES_PER_DECK=30

# SearXNG runs as its own container; this is wired by the compose file.
SEARXNG_SECRET=change-me-to-a-long-random-string
