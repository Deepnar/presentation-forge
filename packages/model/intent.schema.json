{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forge.local/schemas/deck-intent.json",
  "title": "DeckIntent",
  "description": "Layer A: semantic intent. The model's creative language. No coordinates, colours, or font names.",
  "type": "object",
  "required": ["id", "title", "slides"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "audience": { "type": "string", "maxLength": 300 },
    "objective": { "type": "string", "maxLength": 500 },
    "narrative": { "type": "string", "maxLength": 1000 },
    "designDirection": { "type": "string", "maxLength": 500 },
    "sourcePolicy": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["research", "source-of-truth", "none"] },
        "fileIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/definitions/slideIntent" }
    }
  },
  "definitions": {
    "slideIntent": {
      "type": "object",
      "required": ["id", "purpose", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "title": { "type": "string", "maxLength": 120 },
        "takeaway": { "type": "string", "minLength": 1, "maxLength": 300 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/contentBlock" }
        },
        "visualDirection": { "type": "string", "maxLength": 300 },
        "rhetoricalRole": {
          "enum": ["opening", "context", "problem", "method", "explanation", "evidence", "decision", "recommendation", "limitation", "conclusion", "transition"]
        },
        "relationship": {
          "enum": ["comparison", "sequence", "cause-effect", "cycle", "hierarchy", "part-whole"]
        },
        "layoutHint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "enum": ["title", "content", "comparison", "media", "chart", "process"]
            },
            "emphasis": { "type": "string", "maxLength": 120 },
            "mediaSide": { "enum": ["left", "right"] },
            "flowDirection": { "enum": ["across", "down"], "description": "Whether a sequence reads left to right or top to bottom. Absent means across." },
            "arrangement": { "enum": ["tiers", "radial", "layers", "funnel", "pyramid", "graph", "quadrants", "lanes", "venn"], "description": "How blocks are arranged. Hierarchies: the first block above the rest (tiers), at the centre with the rest around it (radial), every block a full-width band stacked top first (layers) or bands narrowing downward (funnel) or widening downward (pyramid), or a node graph along its connections (graph). Card grids: four blocks as a 2x2 between the slide's axes (quadrants), one row per block group in first-seen order (lanes), or two to four overlapping sets (venn). Absent means the family's default." }
          }
        },
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "speakerNotes": { "type": "string", "maxLength": 20000 },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "description": "The dimensions a slide's blocks are placed along: what each axis measures, its low and high ends, and any tick labels (a roadmap's time periods).",
          "properties": {
            "x": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "maxLength": 60 },
                "low": { "type": "string", "maxLength": 40 },
                "high": { "type": "string", "maxLength": 40 },
                "ticks": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 40 } }
              }
            },
            "y": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "maxLength": 60 },
                "low": { "type": "string", "maxLength": 40 },
                "high": { "type": "string", "maxLength": 40 },
                "ticks": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 40 } }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 30,
          "description": "Directed links between blocks on this slide, by block id — the edges of a diagram.",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "maxLength": 60 }
            }
          }
        }
      }
    },
    "contentBlock": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["text", "list", "stat", "image", "chart", "table", "quote", "callout"]
        },
        "text": { "type": "string", "maxLength": 2000 },
        "items": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 300 } },
        "label": { "type": "string", "maxLength": 240 },
        "value": { "type": "string", "maxLength": 120 },
        "src": { "type": "string", "maxLength": 500 },
        "alt": { "type": "string", "maxLength": 300 },
        "fit": { "enum": ["cover", "contain"], "description": "Whether the image may be cropped to fill its region (cover) or must show whole (contain)." },
        "icon": { "type": "string", "minLength": 1, "maxLength": 16, "description": "A short emoji or symbol that heads the block, drawn as text." },
        "group": { "type": "string", "minLength": 1, "maxLength": 60, "description": "The named group (a roadmap phase, a lane) this block belongs to." },
        "columnAlign": { "type": "array", "maxItems": 12, "items": { "enum": ["left", "center", "right"] }, "description": "A table's text alignment per column, as authored." },
        "emphasisRows": { "type": "array", "maxItems": 40, "items": { "type": "integer", "minimum": 0 }, "description": "Table rows (indexes into rows, header included) the author marked for emphasis." },
        "caption": { "type": "string", "maxLength": 300 },
        "chartKind": { "enum": ["bar", "hbar", "line", "pie", "doughnut", "area"] },
        "categories": { "type": "array", "items": { "type": "string", "maxLength": 60 } },
        "series": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 60 },
              "values": { "type": "array", "minItems": 1, "items": { "type": "number" } }
            }
          }
        },
        "unit": { "type": "string", "maxLength": 16 },
        "emphasis": { "enum": ["primary", "supporting", "context"] },
        "evidenceRefs": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "outcome": { "enum": ["favorable", "unfavorable", "mixed", "neutral"] },
        "uncertainty": { "enum": ["qualified", "mixed", "inconclusive", "contested"] },
        "status": {
          "description": "Authored implementation status. Absent means unspecified — never defaulted. Orthogonal to outcome, uncertainty, emphasis, and role.",
          "enum": ["implemented", "planned"]
        },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
        },
        "header": { "type": "boolean" },
        "mediaRole": { "enum": ["evidence", "explanatory", "decorative"] },
        "measure": { "enum": ["comparison", "trend", "composition", "distribution", "association"] }
      }
    }
  }
}
