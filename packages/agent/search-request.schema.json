{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forge.local/schemas/search-request.json",
  "title": "SearchRequest",
  "description": "Bounded semantic web search. Project identity and backend configuration are trusted host inputs, never query arguments.",
  "type": "object",
  "required": ["query"],
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 20 },
    "perHost": { "type": "integer", "minimum": 1, "maximum": 5 },
    "language": { "type": "string", "maxLength": 35, "pattern": "^(?:[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?|all)$" },
    "timeRange": { "enum": ["day", "month", "year"] }
  }
}
