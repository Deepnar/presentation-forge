{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnProposal",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "turnId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "editCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "decision": {
      "anyOf": [
        {
          "enum": [
            "approve",
            "reject",
            "cancel"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionKey": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decisionDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "id",
    "turnId",
    "generation",
    "revision",
    "projectRevision",
    "digest",
    "expiresAt",
    "editCount",
    "decision",
    "decisionKey",
    "runId",
    "publishedAt",
    "decisionDigest"
  ],
  "additionalProperties": false
}
