{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TurnHeader",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accounting": {
      "type": "object",
      "properties": {
        "reservedOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownCacheReadTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownCacheWriteTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "reservedOutputTokens",
        "knownInputTokens",
        "knownOutputTokens",
        "knownCacheReadTokens",
        "knownCacheWriteTokens",
        "knownAttempts",
        "unknownAttempts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "generation",
    "revision",
    "createdAt",
    "updatedAt",
    "accounting"
  ],
  "additionalProperties": false
}
