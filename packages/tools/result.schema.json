{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "forbidden",
            "invalid-input",
            "budget-exceeded",
            "unknown-slide",
            "unknown-element",
            "not-editable",
            "locked",
            "stale-revision",
            "duplicate-id",
            "invalid-edit",
            "engine-refused",
            "unavailable"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "ok",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "boolean"
        },
        "preserved": {
          "type": "array",
          "items": {
            "enum": [
              "geometry",
              "styling",
              "untargeted-content",
              "tombstones"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "slides": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slideId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "elementCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "layoutState": {
                    "enum": [
                      "managed",
                      "customized",
                      "detached"
                    ]
                  }
                },
                "required": [
                  "slideId",
                  "position",
                  "elementCount",
                  "layoutState"
                ],
                "additionalProperties": false
              }
            },
            "nextOffset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "total",
            "slides",
            "nextOffset"
          ],
          "additionalProperties": false
        },
        "tool": {
          "const": "get_project"
        }
      },
      "required": [
        "ok",
        "revision",
        "changed",
        "preserved",
        "warnings",
        "data",
        "tool"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "boolean"
        },
        "preserved": {
          "type": "array",
          "items": {
            "enum": [
              "geometry",
              "styling",
              "untargeted-content",
              "tombstones"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "slideId": {
              "type": "string",
              "minLength": 1
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ElementProjection"
              }
            },
            "nextOffset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "slideId",
            "total",
            "elements",
            "nextOffset"
          ],
          "additionalProperties": false
        },
        "tool": {
          "const": "get_slide"
        }
      },
      "required": [
        "ok",
        "revision",
        "changed",
        "preserved",
        "warnings",
        "data",
        "tool"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
