            "type": "string",
            "maxLength": 256
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slideId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element": {
                    "$ref": "#/definitions/ElementProjection"
                  }
