{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_project"
        },
        "args": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_slide"
        },
        "args": {
          "type": "object",
          "properties": {
            "slideId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "slideId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_selected_elements"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "edit_content"
        },
        "args": {
          "type": "object",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edits": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "text"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "paragraphIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "runIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 16000
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "paragraphIndex",
                      "runIndex",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "chart"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "categories": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 16000
                        },
                        "minItems": 1,
                        "maxItems": 120
                      },
                      "series": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 1,
                              "maxItems": 120
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 20
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "categories",
                      "series"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "table"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "rows": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 16000
                          },
                          "minItems": 1,
                          "maxItems": 20
                        },
                        "minItems": 1,
                        "maxItems": 120
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "rows"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "baseRevision",
            "edits"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    }
  ]
}
