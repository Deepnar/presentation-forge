{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_project"
        },
        "args": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_slide"
        },
        "args": {
          "type": "object",
          "properties": {
            "slideId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "slideId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_selected_elements"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "edit_content"
        },
        "args": {
          "type": "object",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edits": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "text"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "paragraphIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "runIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 16000
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "paragraphIndex",
                      "runIndex",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "chart"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "categories": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 16000
                        },
                        "minItems": 1,
                        "maxItems": 120
                      },
                      "series": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              },
                              "minItems": 1,
                              "maxItems": 120
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 20
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "categories",
                      "series"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "table"
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "elementId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "rows": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 16000
                          },
                          "minItems": 1,
                          "maxItems": 20
                        },
                        "minItems": 1,
                        "maxItems": 120
                      }
                    },
                    "required": [
                      "kind",
                      "slideId",
                      "elementId",
                      "rows"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "baseRevision",
            "edits"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "web_search"
        },
        "args": {
          "description": "Bounded semantic web search. Project identity and backend configuration are trusted host inputs, never query arguments.",
          "type": "object",
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "perHost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "language": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^(?:[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?|all)$"
            },
            "timeRange": {
              "enum": [
                "day",
                "month",
                "year"
              ]
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "add_slide"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseRevision",
            "afterSlideId",
            "slide"
          ],
          "description": "Propose a new slide, written as content only: the compiler lays it out in the project's theme. It is added only after the person approves.",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "afterSlideId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "The slide it follows; null puts it first."
            },
            "slide": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "blocks"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "text",
                          "list",
                          "stat",
                          "quote"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "insert_slide"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseRevision",
            "index",
            "scene"
          ],
          "description": "Host-only plan step: a slide the compiler already laid out. Never offered to a model.",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "scene": {
              "type": "object"
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "rewrite_slide"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseRevision",
            "slideId",
            "slide"
          ],
          "description": "Propose new content for an existing slide: the compiler lays it out again in the project's theme, keeping what the person moved, locked or added. It changes only after the person approves.",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "slide": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "blocks"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "text",
                          "list",
                          "stat",
                          "quote"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      }
                    }
                  }
                }
              }
            },
            "slideId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "The slide to rewrite."
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "replace_slide"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseRevision",
            "slideId",
            "scene"
          ],
          "description": "Host-only plan step: a slide's replacement, already laid out. Never offered to a model.",
          "properties": {
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scene": {
              "type": "object"
            },
            "slideId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "list_files"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false,
          "description": "The files the person added to this project, with the role each plays (source-of-truth outranks other sources)."
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "read_file"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileId"
          ],
          "description": "A page of a project file's text.",
          "properties": {
            "fileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            }
          }
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
    }
  ]
}
