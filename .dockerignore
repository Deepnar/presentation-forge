# Whitelist the files the Dockerfile actually COPYs. The legacy Docker builder
# on this machine ignored the intuitive blacklist form and uploaded ~950 MB of
# node_modules and generated decks before starting the build. A whitelist makes
# the installation contract obvious and works with both legacy and BuildKit
# builders.
*

!package.json
!package-lock.json
!README.md
!.dockerignore

!app/
!app/**
!src/
!src/**
!schema/
!schema/**
!themes/
!themes/**
!styles/
!styles/**
!templates/
!templates/**
!tools/
!tools/**

# The image seeds only committed YAML templates into its persistent /data
# volume; personal identity, SQLite state, uploads and keys must never cross
# the image boundary.
!config/
!config/identity.example.yaml
!config/models.yaml

!docker/
!docker/Dockerfile
!docker/entrypoint.sh
